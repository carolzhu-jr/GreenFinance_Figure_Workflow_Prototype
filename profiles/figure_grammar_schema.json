{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Figure Grammar Schema",
  "description": "Minimal data-driven figure specification schema for simple marks, encodings, scales and axes.",
  "type": "object",
  "required": ["data", "marks"],
  "properties": {
    "meta": { "type": "object" },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "values"],
        "properties": {
          "name": { "type": "string" },
          "values": {
            "type": "array",
            "items": { "type": "object" }
          }
        }
      }
    },
    "scales": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "enum": ["linear", "ordinal"] },
          "domain": { "type": "array" },
          "range": { "type": "array" }
        }
      }
    },
    "axes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "orient": { "type": "string", "enum": ["bottom", "left", "top", "right"] },
          "scale": { "type": "string" },
          "ticks": { "type": "integer" }
        },
        "required": ["orient", "scale"]
      }
    },
    "marks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "from"],
        "properties": {
          "type": { "type": "string", "enum": ["point", "line", "bar"] },
          "from": { "type": "string" },
          "encoding": {
            "type": "object",
            "properties": {
              "x": { "type": "object", "required": ["field", "scale"], "properties": { "field": { "type": "string" }, "scale": { "type": "string" } } },
              "y": { "type": "object", "required": ["field", "scale"], "properties": { "field": { "type": "string" }, "scale": { "type": "string" } } },
              "color": { "type": "object", "properties": { "value": { "type": "string" }, "field": { "type": "string" } } },
              "size": { "type": "object", "properties": { "value": { "type": "number" } } }
            }
          },
          "layer": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": false
}
